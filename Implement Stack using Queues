class MyStack {
    int n;
    int top;
    int[] a;
    public MyStack() {
        n=1000;
        top=-1;
        a=new int[n];
    }
    
    public void push(int x) {
            if (top==n-1){
                return;
            }
            top++;
            a[top]=x;
    }
    
    public int pop() {
        if(empty()){
            return -1;
        }
    
        int val=a[top];
        top--;
        return val;
    }
    
    public int top() {
        if(empty()){
            return -1;
        }
        return a[top];
    }
    
    public boolean empty() {
        return top==-1;
    }
}

