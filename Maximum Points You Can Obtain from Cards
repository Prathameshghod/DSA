class Solution {
    public int maxScore(int[] cardPoints, int k) {
        int n=cardPoints.length;
        int c=0;
        for(int i=0;i<k;i++){
            c+=cardPoints[i];
        }
        int m=c;

        int r=n-1;
        for(int i=k-1;i>=0;i--){
            c-=cardPoints[i];
            c+=cardPoints[r];
            m=Math.max(m,c);

            r--;
        }
        return m;
    }
}
