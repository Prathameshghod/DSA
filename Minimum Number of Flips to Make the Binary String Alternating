class Solution {
    public int minFlips(String s) {

        int n = s.length();
        String str = s + s;

        int ans = Integer.MAX_VALUE;

        int diff1 = 0, diff2 = 0;
        int l = 0;

        for(int r = 0; r < str.length(); r++){

            char expected1 = (r % 2 == 0) ? '0' : '1';
            char expected2 = (r % 2 == 0) ? '1' : '0';

            if(str.charAt(r) != expected1) diff1++;
            if(str.charAt(r) != expected2) diff2++;

            if(r - l + 1 > n){

                char left1 = (l % 2 == 0) ? '0' : '1';
                char left2 = (l % 2 == 0) ? '1' : '0';

                if(str.charAt(l) != left1) diff1--;
                if(str.charAt(l) != left2) diff2--;

                l++;
            }

            if(r - l + 1 == n){
                ans = Math.min(ans, Math.min(diff1, diff2));
            }
        }

        return ans;
    }
}
