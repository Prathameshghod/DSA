class Solution {
    public int[] asteroidCollision(int[] asteroids) {
        Deque<Integer> s= new ArrayDeque<>();
        int n=asteroids.length;
        for(int i=n-1;i>=0;i--){
            int a=asteroids[i];
            boolean b=false;
            while(!s.isEmpty() && s.peek()<0 && a>0){
                if(Math.abs(s.peek()) < a){
                    s.pop();        
                }
                else if(Math.abs(s.peek()) == a){
                    s.pop(); 
                    b=true;
                    break;       
                }
                else{
                    b=true;
                    break;
                }
               
            }
             if(!b){
                    s.push(a);
                }
        
        }
          int size = s.size();  
        int[] result = new int[size];

        for (int i = 0; i < size; i++) {
            result[i] = s.pop();
        }

        return result;
    }
}
