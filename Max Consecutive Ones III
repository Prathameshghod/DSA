class Solution {
    public int longestOnes(int[] nums, int k) {
        int n=nums.length;
        int m=0;
        int l=0;
        int r=0;
        int z=0;
        while(r<n){
            if(nums[r]==0){
                z++;
            }
            if(z>k){
                if(nums[l]==0){
                    z--;
                }
                l++;
            }
           
            m=Math.max(m,r-l+1);
             r++;
        }
        return m;
    }
}
