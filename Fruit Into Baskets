class Solution {
    public int totalFruit(int[] fruits) {
        int n=fruits.length;
        int m=0;
        int l=0;
        int f1=-1;
        int f2=-1;
        int c1=0;
        int c2=0;
        for(int i=0;i<n;i++){
            if(f1==fruits[i]){
                c1++;
            }
            else if(f2==fruits[i]){
                c2++;
            }
            else{
                if(f1==-1){
                    f1=fruits[i];
                    c1++;
                }
                else if(f2==-1){
                    f2=fruits[i];
                    c2++;
                }
                else{
                    while(c1>0 && c2>0){
                        if(f1==fruits[l]){
                            c1--;
                        }
                        else if(f2==fruits[l]){
                            c2--;
                        }
                        l++;
                    }
                    if(c1==0){
                        f1=fruits[i];
                        c1++;
                    }
                    else if(c2==0){
                        f2=fruits[i];
                        c2++;
                    }

                }
            }
            m=Math.max(m,c1+c2);
        }
        return m;
    }
}
