    public int[] sortByBits(int[] arr) {
        List<Integer>[] a=new ArrayList[33];
        for(int i=0;i<33;i++){
            a[i]=new ArrayList<>();
        }
        for(int i:arr){
            int cb=Integer.bitCount(i);
            a[cb].add(i);
        }
        int idx=0;
        for(int i=0;i<33;i++){
            Collections.sort(a[i]);
            for(int j:a[i]){
                arr[idx++]=j;
            }
        }
        return arr;
    }
}
