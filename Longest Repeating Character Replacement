class Solution {
    public int characterReplacement(String s, int k) {
        int n=s.length();
        int m=0;
        int l=0;
        int r=0;
        int b=0;
        int[] a= new int[26];
        while(r<n){
            char c=s.charAt(r);
            a[c-'A']++;
            b=Math.max(b,a[c-'A']);

            while((r-l+1)-b>k){
                a[s.charAt(l)-'A']--;
                l++;
            }
           
            m=Math.max(m,r-l+1);
            r++;
        }
        return m;
    }
}
