class Solution {
    public int numSubarraysWithSum(int[] nums, int goal) {
        int n=nums.length;
        int a=0;
        for(int i=0;i<n;i++){
            int c=0;
            for(int j=i;j<n;j++){
                c+=nums[j];
                if(c==goal){
                    a++;
                }
            }
        }
        return a;
    }
}
