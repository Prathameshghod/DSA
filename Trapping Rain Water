class Solution {
    public int trap(int[] height) {
        
        int n=height.length;
        int l=0;
        int r=n-1;

        int ml=0;
        int mr=0;

        int c=0;
        while(l<=r){
            if(height[l]<=height[r]){
                if(height[l]>=ml){
                    ml=height[l];
                }
                else{
                    c+=ml-height[l];
                }
                l++;
            }
            else{
                if(height[r]>=mr){
                    mr=height[r];
                }
                else{
                    c+=mr-height[r];
                }
                r--;
            }
        }
        return c;
    }
}
